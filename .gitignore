# ==============================
# Machine learning / CV artifacts
# ==============================
# Ignore generated model checkpoints and weights
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.tflite
*.safetensors

# Ignore generated datasets and embeddings
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# Ignore local model caches
.cache/
.huggingface/
models/

